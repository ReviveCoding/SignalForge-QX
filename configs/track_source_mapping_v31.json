      "eia": []
    },
    "GLD": {
      "cftc": [
        "Gold"
      ],
      "eia": []
    },
    "SLV": {
      "cftc": [
        "Silver"
      ],
      "eia": []
    },
    "USO": {
      "cftc": [
        "WTI Crude Oil"
      ],
      "eia": [
        "commercial_crude_stocks",
        "refinery_utilization",
        "petroleum_supply"
      ]
