{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalforge:run:v3",
  "title": "SignalForge run receipt",
  "type": "object",
  "required": [
    "study_id",
    "protocol_hash",
    "run_id",
    "phase",
    "task_kind",
    "code_hash",
    "environment_id",
    "state",
    "evidence_kind"
  ],
  "additionalProperties": false,
  "properties": {
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_hash": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "P00",
        "P01",
        "P02",
        "P03",
        "P04",
        "P05",
        "P06",
        "P07",
        "P08",
        "P09",
        "P10",
        "P11",
        "P12",
        "P13",
        "P14",
        "P15"
      ]
    },
    "data_hash": {
      "type": "string",
      "minLength": 1
    },
    "split_id": {
      "type": "string",
      "minLength": 1
    },
    "information_set": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "code_hash": {
      "type": "string",
      "minLength": 1
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "PLANNED",
        "READY",
        "RUNNING",
        "SUCCEEDED",
        "FAILED_RETRYABLE",
        "FAILED_PERMANENT",
        "BLOCKED_DATA",
        "BLOCKED_AUTH",
        "BLOCKED_GPU",
        "PAUSED_BUDGET",
        "PAUSED_HARDWARE",
        "INVALIDATED",
        "DEFERRED_METHOD",
        "SKIPPED_OPTIONAL",
        "BLOCKED_PRICE_P1"
      ]
    },
    "evidence_kind": {
      "enum": [
        "synthetic_fixture",
        "real_pilot",
        "development",
        "reserved_retrospective",
        "prospective",
        "systems_benchmark"
      ]
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "device": {
      "enum": [
        "cpu",
        "cuda:0"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "task_kind": {
      "enum": [
        "environment",
        "desktop",
        "acquisition",
        "transform",
        "model_fit",
        "model_inference",
        "postprocess",
        "score",
        "portfolio",
        "report",
        "forward"
      ]
    },
    "upstream_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalizer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparison_grid_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_kind": {
            "enum": [
              "model_fit",
              "model_inference"
            ]
          }
        }
      },
      "then": {
        "required": [
          "data_hash",
          "split_id",
          "information_set",
          "model_id",
          "seed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task_kind": {
            "const": "score"
          }
        }
      },
      "then": {
        "required": [
          "data_hash",
          "split_id",
          "normalizer_id",
          "comparison_grid_id"
        ]
      }
    }
  ]
}
